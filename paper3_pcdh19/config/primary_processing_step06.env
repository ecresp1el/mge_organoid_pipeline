# Tuning map: ../STEP06_CODE_AND_TUNING_GUIDE.md
# Values below are copied at submission. Editing this file cannot alter an existing frozen run.
# Env suffix -> CLI lowercase-hyphen option -> Step06Settings lowercase_underscore field.
# Code-only marker lists and heuristic thresholds live in step06_analysis.py / step06_metrics.py.

# Approved lineage and frozen parameters for primary-processing Step 06.
# Pinned runtime; the submitter verifies installed versions against requirements.txt.
PRIMARY_PROCESSING_PYTHON_BIN=/home/elcrespo/miniconda3/envs/mge-organoid-python/bin/python
# Approved input run identity; not a tuning parameter. No automatic latest-run selection.
PRIMARY_PROCESSING_STEP06_STEP02_RUN_ID=02_qc_filtering_20260830_124611_97e1bb5
# Relative checkpoint within the approved Step 02 run; raw-count input stays read-only.
PRIMARY_PROCESSING_STEP06_STEP02_CHECKPOINT=objects/pcdh19_step02_qc_filtered.h5ad
# Exact approved file size guard. Do not relax to bypass an input mismatch.
PRIMARY_PROCESSING_STEP06_INPUT_BYTES=6554152927
# Exact approved checksum guard. Do not change as part of a parameter sweep.
PRIMARY_PROCESSING_STEP06_INPUT_SHA256=fadba4a25a7b6b7320219b21c189b6325687493519ba0fe1bd27efd79606b103
# Identity guard: all 446,349 approved Step 02 cells must survive. Do not tune.
PRIMARY_PROCESSING_STEP06_EXPECTED_CELLS=446349
# Identity guard: all 19,071 approved genes must survive. Do not tune.
PRIMARY_PROCESSING_STEP06_EXPECTED_GENES=19071
# Grouping key for HVGs, pseudobulk, mixing and sample summaries; changing it changes the question.
PRIMARY_PROCESSING_STEP06_SAMPLE_FIELD=technical_sample_id
# Registered genotype metadata used for descriptive grouping and colors, not PCA predictors.
PRIMARY_PROCESSING_STEP06_GENOTYPE_FIELD=genotype
# Registered sex metadata used for descriptive grouping and colors, not PCA predictors.
PRIMARY_PROCESSING_STEP06_SEX_FIELD=sex
# Registered combined design group used for display; not an integration covariate.
PRIMARY_PROCESSING_STEP06_DESIGN_FIELD=design_group
# Per-cell count total before natural log1p; changes all downstream expression-based results.
PRIMARY_PROCESSING_STEP06_TARGET_SUM=10000
# Called on RAW counts; seurat_v3 expects counts. Other flavors are not drop-in replacements.
PRIMARY_PROCESSING_STEP06_HVG_FLAVOR=seurat_v3
# Number of HVGs defining PCA and HVG-only pseudobulk similarity; all genes remain in output.
PRIMARY_PROCESSING_STEP06_N_TOP_GENES=3000
# Number of centered PCs fitted and supplied to neighbors; must be below n_top_genes.
PRIMARY_PROCESSING_STEP06_PCA_COMPONENTS=50
# First PCs used for sample-center distances; affects review flags, not the neighbor graph.
PRIMARY_PROCESSING_STEP06_CENTROID_COMPONENTS=20
# Graph locality: larger neighborhoods average over broader structure; affects mixing and clustering.
PRIMARY_PROCESSING_STEP06_N_NEIGHBORS=30
# Scanpy worker setting. Production env supplies 32; does not guarantee every algorithm uses 32 workers.
PRIMARY_PROCESSING_STEP06_N_JOBS=32
# Distance between cells in PCA space; changing metric changes graph, mixing, UMAP and Leiden.
PRIMARY_PROCESSING_STEP06_NEIGHBOR_METRIC=cosine
# UMAP packing parameter; changes display geometry and UMAP displacement flags, not graph-based entropy.
PRIMARY_PROCESSING_STEP06_UMAP_MIN_DIST=0.3
# UMAP scale parameter; affects layout and UMAP center flags, not the fitted PCA or graph.
PRIMARY_PROCESSING_STEP06_UMAP_SPREAD=1.0
# Cluster granularity; changes marker-winner states and composition summaries, not graph construction.
PRIMARY_PROCESSING_STEP06_LEIDEN_RESOLUTION=1.0
# Reproducibility control passed to PCA/graph/UMAP/Leiden/rendering, not a fit-quality knob.
PRIMARY_PROCESSING_STEP06_RANDOM_SEED=20260903
# Display-only cap split across samples; scientific computations still use all cells.
PRIMARY_PROCESSING_STEP06_RENDER_MAX_CELLS=120000
# PNG rendering resolution; no effect on coordinates, scores, or decisions.
PRIMARY_PROCESSING_STEP06_PLOT_DPI=180
# H5AD storage codec; affects file size/time, not raw count values.
PRIMARY_PROCESSING_STEP06_COMPRESSION=lzf
# Scheduler CPU allocation; also sets BLAS/OMP/Numba thread limits in the SLURM wrapper.
PRIMARY_PROCESSING_STEP06_CPUS=32
# Scheduler memory request, not an analysis subsampling setting.
PRIMARY_PROCESSING_STEP06_MEMORY=512G
# Scheduler time limit, days-hours:minutes:seconds; changing it does not tune biology.
PRIMARY_PROCESSING_STEP06_WALLTIME=3-00:00:00
# Scheduler queue/resource class; use a compatible memory request.
PRIMARY_PROCESSING_STEP06_PARTITION=largemem
