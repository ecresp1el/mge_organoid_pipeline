# Resources and fixed scientific choices for the first E15 MGE mapping diagnostic.
# Source paths and scheduler account are inherited from greatlakes.env.

MAPPING_PYTHON_BIN=/home/elcrespo/miniconda3/envs/mge-organoid-python/bin/python
MAPMYCELLS_PYTHON_BIN=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/paper3_pcdh19/software/mapmycells-v1.7.4/bin/python
MAPPING_R_MODULE=r-seurat/5.1.0-R-4.4.1-c3m7yfq
MAPPING_COMPILER_MODULE=gcc/13.2.0
MAPPING_HDF5_MODULE=hdf5/1.10.8
MAPPING_R_ADDON_LIB=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/paper3_pcdh19/software/r-seurat-5.1-addons

# Fixed before inspecting query predictions. This is a diagnostic abstention
# threshold, not an optimized biological decision boundary.
MIND_UNASSIGNED_THRESHOLD=0.50
MAPPING_RANDOM_SEED=20260829
MAPPING_CURATION_RUN_ID=00_developing_mouse_mge_reference_curation_20260829_141944_3b2ad52

MAPPING_PREPARE_CPUS=8
MAPPING_PREPARE_MEMORY=128G
MAPPING_PREPARE_WALLTIME=08:00:00

MAPPING_MIND_CPUS=12
MAPPING_MIND_MEMORY=176G
MAPPING_MIND_WALLTIME=24:00:00

MAPPING_MMC_CPUS=16
MAPPING_MMC_MEMORY=176G
MAPPING_MMC_WALLTIME=24:00:00

MAPPING_REPORT_CPUS=4
MAPPING_REPORT_MEMORY=176G
MAPPING_REPORT_WALLTIME=06:00:00

# Official Allen WMB-10X / CCN20230722 local MapMyCells assets. The supertype
# is not directly traversed; MapMyCells retains and backfills it in output.
MAPMYCELLS_ASSET_VERSION=20240831
MAPMYCELLS_MARKERS_URL=https://allen-brain-cell-atlas.s3-us-west-2.amazonaws.com/mapmycells/WMB-10X/20240831/mouse_markers_230821.json
MAPMYCELLS_STATS_URL=https://allen-brain-cell-atlas.s3-us-west-2.amazonaws.com/mapmycells/WMB-10X/20240831/precomputed_stats_ABC_revision_230821.h5
MAPMYCELLS_DROP_LEVEL=CCN20230722_SUPT
