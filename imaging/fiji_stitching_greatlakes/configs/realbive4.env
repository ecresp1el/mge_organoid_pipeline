# Reproduce the validated BC43/realbive4 Fiji stitch only.
MODE=production

# The recipient must have read access to INPUT_DIR and write access to RUN_PARENT.
INPUT_DIR=/nfs/turbo/umms-parent/andor_microscope_data_dump/exp17_pv_reporter_with_biver3and4/20x
LAYOUT_FILE=tile_configs/realbive4_corrected_stage.txt
RUN_PARENT=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/results/imaging/fiji_stitching_portable_runs
RUN_NAME=realbive4_corrected_reproduction
OUTPUT_PREFIX=cl32_bive4_pv_reporter_40x_realbive4_corrected_stage

# Change ACCOUNT when sharing with a collaborator who uses another allocation.
ACCOUNT=parent0
PARTITION=standard
CPUS=8
MEMORY=64G
WALLTIME=12:00:00
JAVA_HEAP=48g

CHANNELS="1 2"
CHECKSUM_OUTPUTS=true
