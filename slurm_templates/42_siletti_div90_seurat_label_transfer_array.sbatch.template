#!/usr/bin/env bash
# Run Siletti adult reference -> DIV90 neuron Seurat label-transfer knob sweep.
#
# Submit after bridge export succeeds:
#   cp slurm_templates/42_siletti_div90_seurat_label_transfer_array.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/42_siletti_div90_seurat_label_transfer_array.sbatch
#   sbatch --dependency=afterok:<bridge_array_jobid> \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/42_siletti_div90_seurat_label_transfer_array.sbatch

#SBATCH --job-name=siletti-div90-xfer
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --array=0-7
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=180G
#SBATCH --time=08:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-div90-xfer-%A_%a.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-div90-xfer-%A_%a.err

set -euo pipefail

module load Bioinformatics
SEURAT5_MODULE="${SEURAT5_MODULE:-r-seurat/5.1.0-R-4.4.1-c3m7yfq}"
module load "${SEURAT5_MODULE}"

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
SILETTI_BRIDGE_RUN_LABEL="${SILETTI_BRIDGE_RUN_LABEL:-siletti_div90_seurat_bridge_v1}"
SILETTI_TRANSFER_RUN_LABEL="${SILETTI_TRANSFER_RUN_LABEL:-siletti_div90_seurat_label_transfer_sweep_v1}"
SILETTI_TRANSFER_LABEL_COLUMN="${SILETTI_TRANSFER_LABEL_COLUMN:-candidate_jia_group}"
SILETTI_TRANSFER_NFEATURES="${SILETTI_TRANSFER_NFEATURES:-3000}"
SILETTI_TRANSFER_NPCS="${SILETTI_TRANSFER_NPCS:-50}"
SILETTI_TRANSFER_SEED="${SILETTI_TRANSFER_SEED:-0}"
SILETTI_TRANSFER_K_WEIGHT="${SILETTI_TRANSFER_K_WEIGHT:-50}"

configs=(
  "mge_llc rpca 20"
  "mge_llc rpca 50"
  "mge_llc cca 20"
  "mge_llc cca 50"
  "mge_cge_llc rpca 20"
  "mge_cge_llc rpca 50"
  "mge_cge_llc cca 20"
  "mge_cge_llc cca 50"
)
read -r scope reduction dims <<<"${configs[${SLURM_ARRAY_TASK_ID}]}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT

bridge_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_BRIDGE_RUN_LABEL}/${scope}/seurat_bridge"
outdir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_TRANSFER_RUN_LABEL}/${scope}/${reduction}_dims${dims}"

echo "Siletti DIV90 Seurat label transfer started: $(date)"
echo "Host: $(hostname)"
echo "Array task: ${SLURM_ARRAY_TASK_ID}"
echo "Scope: ${scope}"
echo "Reduction: ${reduction}"
echo "Dims: ${dims}"
echo "Label column: ${SILETTI_TRANSFER_LABEL_COLUMN}"
echo "Bridge dir: ${bridge_dir}"
echo "Output dir: ${outdir}"
echo "Seurat module: ${SEURAT5_MODULE}"
echo "Rscript: $(Rscript --version 2>&1 | head -n 1)"

Rscript -e "invisible(parse(file='scripts/31_run_siletti_div90_seurat_label_transfer.R')); cat('parse_ok\n')"

Rscript scripts/31_run_siletti_div90_seurat_label_transfer.R \
  --bridge-dir "${bridge_dir}" \
  --outdir "${outdir}" \
  --label-column "${SILETTI_TRANSFER_LABEL_COLUMN}" \
  --reduction "${reduction}" \
  --dims "${dims}" \
  --nfeatures "${SILETTI_TRANSFER_NFEATURES}" \
  --npcs "${SILETTI_TRANSFER_NPCS}" \
  --seed "${SILETTI_TRANSFER_SEED}" \
  --k-weight "${SILETTI_TRANSFER_K_WEIGHT}"

echo "Generated files:"
find "${outdir}" -maxdepth 3 -type f | sort
echo "Siletti DIV90 Seurat label transfer finished: $(date)"
