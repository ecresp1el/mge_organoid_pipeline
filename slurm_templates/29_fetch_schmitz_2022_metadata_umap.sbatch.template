#!/usr/bin/env bash
# Fetch Schmitz 2022 Cell Browser metadata, decode UMAP coordinates, and plot UMAPs.
#
# Submit:
#   cp slurm_templates/29_fetch_schmitz_2022_metadata_umap.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/29_fetch_schmitz_2022_metadata_umap.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/29_fetch_schmitz_2022_metadata_umap.sbatch

#SBATCH --job-name=schmitz-ref-umap
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/schmitz-ref-umap-%x-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/schmitz-ref-umap-%x-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
SCHMITZ_2022_RUN_LABEL="${SCHMITZ_2022_RUN_LABEL:-schmitz_2022_reference_metadata_umap_v1}"
SCHMITZ_2022_OVERWRITE="${SCHMITZ_2022_OVERWRITE:-0}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Run label: ${SCHMITZ_2022_RUN_LABEL}"
echo "Overwrite existing staged files: ${SCHMITZ_2022_OVERWRITE}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

args=(
  --project-root "${PROJECT_ROOT}"
  --run-label "${SCHMITZ_2022_RUN_LABEL}"
)

if [[ "${SCHMITZ_2022_OVERWRITE}" == "1" ]]; then
  args+=(--overwrite)
fi

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/fetch_schmitz_2022_metadata_umap.py "${args[@]}"

RUN_DIR="${PROJECT_ROOT}/results/schmitz_2022_reference_metadata_umap/${SCHMITZ_2022_RUN_LABEL}"

echo "Standardized Schmitz tables:"
column -t -s $'\t' "${RUN_DIR}/tables/schmitz_2022_standardized_cell_tables.tsv" || cat "${RUN_DIR}/tables/schmitz_2022_standardized_cell_tables.tsv"

echo "UMAP plot manifest:"
column -t -s $'\t' "${RUN_DIR}/tables/schmitz_2022_umap_plot_manifest.tsv" || cat "${RUN_DIR}/tables/schmitz_2022_umap_plot_manifest.tsv"

echo "Completion table:"
column -t -s $'\t' "${RUN_DIR}/tables/schmitz_2022_reference_metadata_umap_complete.tsv" || cat "${RUN_DIR}/tables/schmitz_2022_reference_metadata_umap_complete.tsv"

echo "Job finished: $(date)"
