#!/bin/bash
# Convert configured Seurat RDS objects to cached AnnData H5AD files.
# This job skips already-current H5AD files unless --overwrite is passed below.
#
# Submit:
#   cp slurm_templates/08_convert_python_anndata.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/08_convert_python_anndata.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/08_convert_python_anndata.sbatch

#SBATCH --job-name=seurat_to_h5ad
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=160G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/08_convert_python_anndata_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/08_convert_python_anndata_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
CONDA_BASE="/home/elcrespo/miniconda3"
CONDA_ENV="mge-organoid-python"
STUDIES="${STUDIES:-all}"
OVERWRITE="${OVERWRITE:-false}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${PROJECT_ROOT}/results/python_anndata"

echo "=== Seurat to AnnData Slurm context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_JOB_NAME=${SLURM_JOB_NAME:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "CONDA_ENV=${CONDA_ENV}"
echo "STUDIES=${STUDIES}"
echo "OVERWRITE=${OVERWRITE}"

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"

export PROJECT_ROOT
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

python --version
which python
Rscript --version
which Rscript

args=(
  "${REPO_ROOT}/python_notebooks/scripts/convert_seurat_to_anndata.py"
  --project-root "${PROJECT_ROOT}"
)

if [[ "${STUDIES}" == "all" ]]; then
  args+=(--studies all)
else
  # shellcheck disable=SC2206
  study_array=(${STUDIES})
  args+=(--studies "${study_array[@]}")
fi

if [[ "${OVERWRITE}" == "true" ]]; then
  args+=(--overwrite)
fi

python "${args[@]}"
