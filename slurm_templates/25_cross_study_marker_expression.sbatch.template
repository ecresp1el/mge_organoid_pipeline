#!/usr/bin/env bash
# Prepare and plot the first Python cross-study marker-expression figure.
#
# Submit:
#   cp slurm_templates/25_cross_study_marker_expression.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/25_cross_study_marker_expression.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/25_cross_study_marker_expression.sbatch

#SBATCH --job-name=cross-marker-expr
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --time=12:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/cross-marker-expression-%x-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/cross-marker-expression-%x-%j.err

set -euo pipefail

module load Bioinformatics
SEURAT5_MODULE="${SEURAT5_MODULE:-r-seurat/5.1.0-R-4.4.1-c3m7yfq}"
module load "${SEURAT5_MODULE}"

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
CROSS_STUDY_MARKER_RUN_LABEL="${CROSS_STUDY_MARKER_RUN_LABEL:-cross_study_marker_expression_v3}"
CROSS_STUDY_MARKER_SEURAT_STUDIES="${CROSS_STUDY_MARKER_SEURAT_STUDIES:-walsh,bershteyn_2025,bershteyn_2023,samarasinghe_2021,siebert_2026}"
CROSS_STUDY_MARKER_MAX_CELLS_PER_STUDY="${CROSS_STUDY_MARKER_MAX_CELLS_PER_STUDY:-}"

RUN_DIR="${PROJECT_ROOT}/results/cross_study_marker_expression/${CROSS_STUDY_MARKER_RUN_LABEL}"
TABLE_DIR="${RUN_DIR}/tables"
PER_STUDY_DIR="${TABLE_DIR}/per_study"
STUDY_TABLE="${TABLE_DIR}/cross_study_marker_expression_studies.tsv"
GENE_TABLE="${TABLE_DIR}/cross_study_marker_expression_genes.tsv"
EXECUTED_DIR="${PROJECT_ROOT}/results/cross_study_marker_expression/executed"
EXECUTED_NAME="cross_study_marker_expression.${CROSS_STUDY_MARKER_RUN_LABEL}.executed.ipynb"
EXECUTED_PATH="${EXECUTED_DIR}/${EXECUTED_NAME}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${PER_STUDY_DIR}" "${EXECUTED_DIR}"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Run label: ${CROSS_STUDY_MARKER_RUN_LABEL}"
echo "Seurat studies: ${CROSS_STUDY_MARKER_SEURAT_STUDIES}"
echo "Max cells per study for plotting: ${CROSS_STUDY_MARKER_MAX_CELLS_PER_STUDY:-none}"
echo "Executed notebook: ${EXECUTED_PATH}"
echo "Seurat module: ${SEURAT5_MODULE}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"
echo "Rscript: $(Rscript --version 2>&1 | head -n 1)"
echo "jupyter: $("${CONDA_ENV_BIN}/jupyter" --version 2>/dev/null | head -n 1)"

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/run_cross_study_marker_expression.py \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${CROSS_STUDY_MARKER_RUN_LABEL}" \
  setup

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/run_cross_study_marker_expression.py \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${CROSS_STUDY_MARKER_RUN_LABEL}" \
  extract-h5ad \
  --study-id varela_div30 \
  --study-id varela_div90

Rscript scripts/12_export_cross_study_marker_expression_tables.R \
  --project-root "${PROJECT_ROOT}" \
  --study-table "${STUDY_TABLE}" \
  --gene-table "${GENE_TABLE}" \
  --outdir "${PER_STUDY_DIR}" \
  --study-id "${CROSS_STUDY_MARKER_SEURAT_STUDIES}"

"${CONDA_ENV_BIN}/jupyter" nbconvert \
  --to notebook \
  --execute python_notebooks/notebooks/cross_study_marker_expression.ipynb \
  --output-dir "${EXECUTED_DIR}" \
  --output "${EXECUTED_NAME}" \
  --ExecutePreprocessor.kernel_name=mge-organoid-python \
  --ExecutePreprocessor.timeout=-1

echo "Readiness table:"
column -t -s $'\t' "${TABLE_DIR}/cross_study_marker_expression_readiness.tsv" || cat "${TABLE_DIR}/cross_study_marker_expression_readiness.tsv"

echo "Job finished: $(date)"
