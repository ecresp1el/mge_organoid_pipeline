#!/bin/bash
#SBATCH --job-name=download_geo
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/01_download_geo_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/01_download_geo_%j.log
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=your_email@umich.edu
#SBATCH --account=parent0
#SBATCH --partition=standard

# Template for downloading GEO datasets.
# NOTE: Slurm does not expand shell variables in `#SBATCH --output/--error`, so we
# keep those as absolute paths to avoid writing logs into the repo.
REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"

set -euo pipefail

mkdir -p "${PROJECT_ROOT}/logs"

export PROJECT_ROOT
"${REPO_ROOT}/scripts/01_download_geo.sh" --project-root "${PROJECT_ROOT}"
