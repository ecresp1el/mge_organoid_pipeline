#!/bin/bash
# Export DIV30 paper/manual cluster annotations into URD inputs and run the
# first URD flood-pseudotime pass rooted in paper Radial glia cells.
#
# Pipeline logic:
#   1. Use conda Python to export a stratified Matrix Market bundle from the
#      existing AnnData-derived DIV30 count matrix plus metadata sidecars.
#   2. Use module R/4.4.3 to run URD on only that plain input bundle.
#   3. Record all imposed URD parameters in
#      tables/div30_first_urd_parameters.tsv in the run directory.
#   4. Write stage-level timing checkpoints to
#      tables/div30_first_urd_stage_timings.tsv and Slurm resource heartbeats
#      to tables/slurm_resource_heartbeat.tsv so long full runs can be
#      diagnosed without guessing where they stalled.
#
# Submit:
#   cp slurm_templates/31_div30_first_urd.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/31_div30_first_urd.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/31_div30_first_urd.sbatch

#SBATCH --job-name=div30_all_urd1
#SBATCH --time=48:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/31_div30_first_urd_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/31_div30_first_urd_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
CONDA_BASE="/home/elcrespo/miniconda3"
CONDA_ENV="${CONDA_ENV:-mge-organoid-python}"
R_MODULE="${R_MODULE:-R/4.4.3}"
RUN_LABEL="${RUN_LABEL:-div30_allcells_radial_glia_firstpass_urd_resumable_v1}"
ROOT_LABEL="${ROOT_LABEL:-Radial glia}"
MAX_CELLS="${MAX_CELLS:-0}"
SEED="${SEED:-7}"
URD_SEED="${URD_SEED:-${SEED}}"
URD_RESUME="${URD_RESUME:-true}"
URD_FORCE_RECOMPUTE="${URD_FORCE_RECOMPUTE:-false}"
URD_MIN_GENES="${URD_MIN_GENES:-500}"
URD_MIN_CELLS="${URD_MIN_CELLS:-3}"
URD_MIN_COUNTS="${URD_MIN_COUNTS:-10}"
URD_PCA_MP_FACTOR="${URD_PCA_MP_FACTOR:-2}"
URD_KNN="${URD_KNN:-100}"
URD_SIGMA="${URD_SIGMA:-local}"
URD_N_FLOODS="${URD_N_FLOODS:-20}"
URD_NUM_VARIABLE_GENES="${URD_NUM_VARIABLE_GENES:-3000}"
URD_FLOOD_MINIMUM_CELLS="${URD_FLOOD_MINIMUM_CELLS:-2}"
URD_FLOOD_MAX_FRAC_NA="${URD_FLOOD_MAX_FRAC_NA:-0.4}"
URD_FLOOD_STABILITY_DIV="${URD_FLOOD_STABILITY_DIV:-}"
HEARTBEAT_INTERVAL_SECONDS="${HEARTBEAT_INTERVAL_SECONDS:-300}"

RUN_ROOT="${PROJECT_ROOT}/results/div30_first_urd/${RUN_LABEL}"
INPUT_DIR="${RUN_ROOT}/inputs"
TABLE_DIR="${RUN_ROOT}/tables"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${RUN_ROOT}" "${INPUT_DIR}" "${TABLE_DIR}"

HEARTBEAT_LOG="${TABLE_DIR}/slurm_resource_heartbeat.tsv"
monitor_resources() {
  printf "timestamp\telapsed_seconds\tslurm_step\tave_cpu\tmax_rss\tave_rss\tmax_vmsize\trun_root_bytes\trun_root_files\n" > "${HEARTBEAT_LOG}"
  while true; do
    ts="$(date '+%F %T')"
    slurm_step="${SLURM_JOB_ID:-}.batch"
    stat_line="$(sstat -j "${slurm_step}" --noheader --format=AveCPU,MaxRSS,AveRSS,MaxVMSize -P 2>/dev/null | tail -n 1 || true)"
    if [[ -z "${stat_line}" ]]; then
      stat_line="NA|NA|NA|NA"
    fi
    bytes="$(du -sb "${RUN_ROOT}" 2>/dev/null | awk '{print $1}' || true)"
    files="$(find "${RUN_ROOT}" -type f 2>/dev/null | wc -l | awk '{print $1}' || true)"
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "${ts}" "${SECONDS}" "${slurm_step}" "${stat_line//|/$'\t'}" "${bytes:-NA}" "${files:-NA}" >> "${HEARTBEAT_LOG}"
    sleep "${HEARTBEAT_INTERVAL_SECONDS}"
  done
}

monitor_resources &
MONITOR_PID=$!
trap 'kill "${MONITOR_PID}" 2>/dev/null || true' EXIT

echo "=== DIV30 first URD Slurm context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_JOB_NAME=${SLURM_JOB_NAME:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "CONDA_ENV=${CONDA_ENV}"
echo "R_MODULE=${R_MODULE}"
echo "RUN_LABEL=${RUN_LABEL}"
echo "ROOT_LABEL=${ROOT_LABEL}"
echo "MAX_CELLS=${MAX_CELLS}"
echo "SEED=${SEED}"
echo "URD_SEED=${URD_SEED}"
echo "URD_RESUME=${URD_RESUME}"
echo "URD_FORCE_RECOMPUTE=${URD_FORCE_RECOMPUTE}"
echo "URD_MIN_GENES=${URD_MIN_GENES}"
echo "URD_MIN_CELLS=${URD_MIN_CELLS}"
echo "URD_MIN_COUNTS=${URD_MIN_COUNTS}"
echo "URD_PCA_MP_FACTOR=${URD_PCA_MP_FACTOR}"
echo "URD_KNN=${URD_KNN}"
echo "URD_SIGMA=${URD_SIGMA}"
echo "URD_N_FLOODS=${URD_N_FLOODS}"
echo "URD_NUM_VARIABLE_GENES=${URD_NUM_VARIABLE_GENES}"
echo "URD_FLOOD_MINIMUM_CELLS=${URD_FLOOD_MINIMUM_CELLS}"
echo "URD_FLOOD_MAX_FRAC_NA=${URD_FLOOD_MAX_FRAC_NA}"
echo "URD_FLOOD_STABILITY_DIV=${URD_FLOOD_STABILITY_DIV:-auto_min_10_n_floods}"
echo "HEARTBEAT_INTERVAL_SECONDS=${HEARTBEAT_INTERVAL_SECONDS}"
echo "HEARTBEAT_LOG=${HEARTBEAT_LOG}"

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"
python --version
which python

echo "=== DIV30 planned post-hoc plots/reports ==="
python "${REPO_ROOT}/python_notebooks/scripts/audit_urd_run_outputs.py" \
  --run-root "${RUN_ROOT}" \
  --mode "div30_first" \
  --outdir "${TABLE_DIR}" \
  --planned-only \
  --artifact-types "plot,report"

python "${REPO_ROOT}/python_notebooks/scripts/export_div30_first_urd_inputs.py" \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${RUN_LABEL}" \
  --outdir "${INPUT_DIR}" \
  --max-cells "${MAX_CELLS}" \
  --seed "${SEED}" \
  --root-label "${ROOT_LABEL}"

conda deactivate

module load "${R_MODULE}"
module list 2>&1
Rscript --version
which Rscript

Rscript -e 'pkgs <- c("Matrix", "URD", "ggplot2"); status <- sapply(pkgs, requireNamespace, quietly=TRUE); print(data.frame(package=pkgs, installed=status), row.names=FALSE); quit(status=ifelse(all(status), 0, 1))'

Rscript "${REPO_ROOT}/scripts/14_div30_first_urd.R" \
  --project-root "${PROJECT_ROOT}" \
  --input-dir "${INPUT_DIR}" \
  --outdir "${RUN_ROOT}" \
  --run-label "${RUN_LABEL}" \
  --root-label "${ROOT_LABEL}" \
  --seed "${URD_SEED}" \
  --min-genes "${URD_MIN_GENES}" \
  --min-cells "${URD_MIN_CELLS}" \
  --min-counts "${URD_MIN_COUNTS}" \
  --pca-mp-factor "${URD_PCA_MP_FACTOR}" \
  --knn "${URD_KNN}" \
  --sigma "${URD_SIGMA}" \
  --n-floods "${URD_N_FLOODS}" \
  --num-variable-genes "${URD_NUM_VARIABLE_GENES}" \
  --flood-minimum-cells "${URD_FLOOD_MINIMUM_CELLS}" \
  --flood-max-frac-na "${URD_FLOOD_MAX_FRAC_NA}" \
  --flood-stability-div "${URD_FLOOD_STABILITY_DIV:-}" \
  --resume "${URD_RESUME}" \
  --force-recompute "${URD_FORCE_RECOMPUTE}"

# Post hoc validation panel. This does not alter the URD object; it reads the
# saved RDS and writes the expected posthoc panel artifacts for every run:
# UMAP pseudotime, diffusion-map pseudotime, diffusion-map annotation, flood
# stability, top pseudotime gene cascade, and positive/negative pseudotime
# gene tables.
Rscript "${REPO_ROOT}/scripts/15_div30_urd_lineage_decision_report.R" \
  --urd-rds "${RUN_ROOT}/div30_first_urd_object.rds" \
  --outdir "${RUN_ROOT}/lineage_decision_report" \
  --annotation-col "paper_cluster_annotation" \
  --pseudotime-name "paper_radial_glia_root" \
  --root-col "urd_root_candidate" \
  --top-n "50" \
  --correlation-genes "variable"

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"
python "${REPO_ROOT}/python_notebooks/scripts/audit_urd_run_outputs.py" \
  --run-root "${RUN_ROOT}" \
  --mode "div30_first" \
  --outdir "${TABLE_DIR}"
