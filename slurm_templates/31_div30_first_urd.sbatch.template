#!/bin/bash
# Export DIV30 paper/manual cluster annotations into URD inputs and run the
# first URD flood-pseudotime pass rooted in paper Radial glia cells.
#
# Submit:
#   cp slurm_templates/31_div30_first_urd.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/31_div30_first_urd.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/31_div30_first_urd.sbatch

#SBATCH --job-name=div30_urd1
#SBATCH --time=48:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=220G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/31_div30_first_urd_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/31_div30_first_urd_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
CONDA_BASE="/home/elcrespo/miniconda3"
CONDA_ENV="${CONDA_ENV:-mge-organoid-python}"
R_MODULE="${R_MODULE:-R/4.4.3}"
RUN_LABEL="${RUN_LABEL:-div30_first_urd_paper_radial_glia_v1}"
ROOT_LABEL="${ROOT_LABEL:-Radial glia}"
MAX_CELLS="${MAX_CELLS:-30000}"
SEED="${SEED:-7}"
URD_KNN="${URD_KNN:-100}"
URD_SIGMA="${URD_SIGMA:-local}"
URD_N_FLOODS="${URD_N_FLOODS:-20}"
URD_NUM_VARIABLE_GENES="${URD_NUM_VARIABLE_GENES:-3000}"

RUN_ROOT="${PROJECT_ROOT}/results/div30_first_urd/${RUN_LABEL}"
INPUT_DIR="${RUN_ROOT}/inputs"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${RUN_ROOT}" "${INPUT_DIR}"

echo "=== DIV30 first URD Slurm context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_JOB_NAME=${SLURM_JOB_NAME:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "CONDA_ENV=${CONDA_ENV}"
echo "R_MODULE=${R_MODULE}"
echo "RUN_LABEL=${RUN_LABEL}"
echo "ROOT_LABEL=${ROOT_LABEL}"
echo "MAX_CELLS=${MAX_CELLS}"
echo "URD_KNN=${URD_KNN}"
echo "URD_SIGMA=${URD_SIGMA}"
echo "URD_N_FLOODS=${URD_N_FLOODS}"
echo "URD_NUM_VARIABLE_GENES=${URD_NUM_VARIABLE_GENES}"

source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"
python --version
which python

python "${REPO_ROOT}/python_notebooks/scripts/export_div30_first_urd_inputs.py" \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${RUN_LABEL}" \
  --outdir "${INPUT_DIR}" \
  --max-cells "${MAX_CELLS}" \
  --seed "${SEED}" \
  --root-label "${ROOT_LABEL}"

conda deactivate

module load "${R_MODULE}"
module list 2>&1
Rscript --version
which Rscript

Rscript -e 'pkgs <- c("Matrix", "URD", "ggplot2"); status <- sapply(pkgs, requireNamespace, quietly=TRUE); print(data.frame(package=pkgs, installed=status), row.names=FALSE); quit(status=ifelse(all(status), 0, 1))'

Rscript "${REPO_ROOT}/scripts/14_div30_first_urd.R" \
  --project-root "${PROJECT_ROOT}" \
  --input-dir "${INPUT_DIR}" \
  --outdir "${RUN_ROOT}" \
  --run-label "${RUN_LABEL}" \
  --root-label "${ROOT_LABEL}" \
  --knn "${URD_KNN}" \
  --sigma "${URD_SIGMA}" \
  --n-floods "${URD_N_FLOODS}" \
  --num-variable-genes "${URD_NUM_VARIABLE_GENES}"
