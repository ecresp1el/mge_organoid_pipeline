#!/bin/bash
# Placeholder for next-stage comparison against human developing GE.
# Consumes prepared object manifest from Stage 06.

#SBATCH --job-name=human_ge_tbd
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/07_human_ge_tbd_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/07_human_ge_tbd_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

module load Bioinformatics
module load r-seurat/5.1.0-R-4.4.1-c3m7yfq

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
