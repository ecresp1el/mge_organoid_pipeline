echo "RUN_LABEL=${RUN_LABEL}"
module list 2>&1

export PROJECT_ROOT
Rscript "${REPO_ROOT}/scripts/07_compare_human_developing_ge_tbd.R" \
  --config "${CONFIG_PATH}" \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${RUN_LABEL}"
