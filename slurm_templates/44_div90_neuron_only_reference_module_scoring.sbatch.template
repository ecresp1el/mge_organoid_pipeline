#!/usr/bin/env bash
# Score Science Data S9 MGE divergence modules in DIV90 neuron-only clusters.
#
# Workbook input:
#   ${PROJECT_ROOT}/reference/science.adw1803_data_s9.xlsx
#
# The Python workflow reads five full module sheets and five TF-only module
# sheets, then separately scores the five biological anchor classes:
#   EPHA5/MEF2C, LHX6/NFIA, CRABP1/ANGPT2, NR2F1/NR2F2, LHX8/ISL1
#
# Output path pattern:
#   ${PROJECT_ROOT}/results/div90_neuron_only_reference_modules/${RUN_LABEL}
#
# Main report:
#   div90_neuron_only_s9_reference_module_report.md

#SBATCH --job-name=div90_s9_modules
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/44_div90_neuron_only_reference_module_scoring_%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/44_div90_neuron_only_reference_module_scoring_%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
RUN_LABEL="${RUN_LABEL:-div90_neuron_only_reference_modules_v1}"
OUTDIR="${PROJECT_ROOT}/results/div90_neuron_only_reference_modules/${RUN_LABEL}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${OUTDIR}"

cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK}"
export NUMEXPR_NUM_THREADS="${SLURM_CPUS_PER_TASK}"

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project root: ${PROJECT_ROOT}"
echo "Output dir: ${OUTDIR}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/div90_neuron_only_reference_module_scoring.py \
  --project-root "${PROJECT_ROOT}" \
  --outdir "${OUTDIR}"

echo "Job finished: $(date)"
