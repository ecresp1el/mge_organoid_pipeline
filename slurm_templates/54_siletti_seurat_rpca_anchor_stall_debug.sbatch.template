#!/usr/bin/env bash
# Debug Seurat FindTransferAnchors stalls on controlled RPCA smoke tests only.
#
# Submit:
#   cp slurm_templates/54_siletti_seurat_rpca_anchor_stall_debug.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/54_siletti_seurat_rpca_anchor_stall_debug.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/54_siletti_seurat_rpca_anchor_stall_debug.sbatch

#SBATCH --job-name=siletti-anchor-debug
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=80G
#SBATCH --time=03:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-anchor-debug-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-anchor-debug-%j.err

set -euo pipefail

module load Bioinformatics
SEURAT5_MODULE="${SEURAT5_MODULE:-r-seurat/5.1.0-R-4.4.1-c3m7yfq}"
module load "${SEURAT5_MODULE}"

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
SILETTI_BRIDGE_RUN_LABEL="${SILETTI_BRIDGE_RUN_LABEL:-siletti_div90_seurat_bridge_v1}"
SILETTI_TRANSFER_RUN_LABEL="${SILETTI_TRANSFER_RUN_LABEL:-siletti_div90_fast_knn_transfer_full_mge_llc_v1}"
SILETTI_TRANSFER_SCOPE="${SILETTI_TRANSFER_SCOPE:-mge_llc}"
SILETTI_TRANSFER_N_COMPONENTS="${SILETTI_TRANSFER_N_COMPONENTS:-50}"
SILETTI_TRANSFER_K="${SILETTI_TRANSFER_K:-50}"
SILETTI_TRANSFER_MAX_REFERENCE_CELLS="${SILETTI_TRANSFER_MAX_REFERENCE_CELLS:-0}"
SILETTI_TRANSFER_MAX_QUERY_CELLS="${SILETTI_TRANSFER_MAX_QUERY_CELLS:-0}"
SILETTI_ANCHOR_DEBUG_RUN_LABEL="${SILETTI_ANCHOR_DEBUG_RUN_LABEL:-seurat_rpca_anchor_stall_debug}"
SILETTI_ANCHOR_DEBUG_TIMEOUT="${SILETTI_ANCHOR_DEBUG_TIMEOUT:-20m}"
SILETTI_ANCHOR_DEBUG_MAX_REFERENCE_CELLS="${SILETTI_ANCHOR_DEBUG_MAX_REFERENCE_CELLS:-2000}"
SILETTI_ANCHOR_DEBUG_MAX_QUERY_CELLS="${SILETTI_ANCHOR_DEBUG_MAX_QUERY_CELLS:-2000}"
SILETTI_ANCHOR_DEBUG_SEED="${SILETTI_ANCHOR_DEBUG_SEED:-0}"
SILETTI_ANCHOR_DEBUG_VERBOSE="${SILETTI_ANCHOR_DEBUG_VERBOSE:-true}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

bridge_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_BRIDGE_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/seurat_bridge"
transfer_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_TRANSFER_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/svd${SILETTI_TRANSFER_N_COMPONENTS}_k${SILETTI_TRANSFER_K}_ref${SILETTI_TRANSFER_MAX_REFERENCE_CELLS}_query${SILETTI_TRANSFER_MAX_QUERY_CELLS}"
outdir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_ANCHOR_DEBUG_RUN_LABEL}"
mkdir -p "${outdir}"

echo "Siletti Seurat RPCA anchor stall debug started: $(date)"
echo "Host: $(hostname)"
echo "Bridge dir: ${bridge_dir}"
echo "Transfer dir: ${transfer_dir}"
echo "Output dir: ${outdir}"
echo "Timeout per test: ${SILETTI_ANCHOR_DEBUG_TIMEOUT}"
echo "Rscript: $(Rscript --version 2>&1 | head -n 1)"

Rscript -e "invisible(parse(file='scripts/33_siletti_seurat_rpca_anchor_stall_debug.R')); cat('parse_ok\n')"

cat > "${outdir}/test_ladder.tsv" <<'EOF'
test_id	nfeatures	dims	k_filter
A	500	10	100
B	1000	20	100
C	3000	20	100
D	3000	20	200
E	3000	20	NA
EOF

summary_path="${outdir}/ladder_run_summary.tsv"
printf "timestamp\ttest_id\tnfeatures\tdims\tk_filter\texit_status\tstatus\n" > "${summary_path}"

while IFS=$'\t' read -r test_id nfeatures dims k_filter; do
  if [[ "${test_id}" == "test_id" ]]; then
    continue
  fi
  echo "[$(date)] Starting test ${test_id}: features=${nfeatures} dims=1:${dims} k.filter=${k_filter}"
  set +e
  timeout "${SILETTI_ANCHOR_DEBUG_TIMEOUT}" Rscript scripts/33_siletti_seurat_rpca_anchor_stall_debug.R \
    --bridge-dir "${bridge_dir}" \
    --transfer-dir "${transfer_dir}" \
    --outdir "${outdir}" \
    --test-id "${test_id}" \
    --nfeatures "${nfeatures}" \
    --dims "${dims}" \
    --k-filter "${k_filter}" \
    --max-reference-cells "${SILETTI_ANCHOR_DEBUG_MAX_REFERENCE_CELLS}" \
    --max-query-cells "${SILETTI_ANCHOR_DEBUG_MAX_QUERY_CELLS}" \
    --seed "${SILETTI_ANCHOR_DEBUG_SEED}" \
    --seurat-verbose "${SILETTI_ANCHOR_DEBUG_VERBOSE}"
  status=$?
  set -e

  if [[ "${status}" -eq 0 ]]; then
    result="completed"
  elif [[ "${status}" -eq 124 ]]; then
    result="timeout_stall_gt_${SILETTI_ANCHOR_DEBUG_TIMEOUT}"
    test_dir="${outdir}/test_${test_id}"
    mkdir -p "${test_dir}"
    cat > "${test_dir}/test_summary.tsv" <<EOF
test_id	completed	n_anchors	find_transfer_anchors_elapsed_sec	error	n_warnings	reference_cells_used	query_cells_used	n_features	dims	k_filter
${test_id}	FALSE	NA	NA	timeout_${SILETTI_ANCHOR_DEBUG_TIMEOUT}	NA	NA	NA	${nfeatures}	1:${dims}	${k_filter}
EOF
  else
    result="failed"
  fi

  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "${test_id}" "${nfeatures}" "${dims}" "${k_filter}" "${status}" "${result}" >> "${summary_path}"
  echo "[$(date)] Test ${test_id} result: ${result} exit=${status}"

  if [[ "${status}" -ne 0 ]]; then
    echo "Stopping ladder at test ${test_id} because status=${status} (${result})."
    break
  fi
done < "${outdir}/test_ladder.tsv"

echo "Generated files:"
find "${outdir}" -maxdepth 3 -type f | sort
echo "Siletti Seurat RPCA anchor stall debug finished: $(date)"
