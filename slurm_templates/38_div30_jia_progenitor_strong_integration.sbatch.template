#!/bin/bash
# DIV30 Jia-style progenitor strong sample-aware integration.
#
# This follow-up keeps the same Phase 1 input cells, produces an uncorrected
# baseline UMAP, then runs Seurat CCA anchor integration across the sample/batch
# column. Review the before/after UMAPs before making biological calls.
#
# Submit:
#   cp slurm_templates/38_div30_jia_progenitor_strong_integration.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/38_div30_jia_progenitor_strong_integration.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/38_div30_jia_progenitor_strong_integration.sbatch

#SBATCH --job-name=div30_prog_int
#SBATCH --time=06:00:00
#SBATCH --cpus-per-task=12
#SBATCH --mem=175G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/38_div30_jia_progenitor_strong_integration_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/38_div30_jia_progenitor_strong_integration_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_div30_progenitor}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
RSCRIPT="${RSCRIPT:-${CONDA_ENV_BIN}/Rscript}"

RUN_LABEL="${RUN_LABEL:-div30_jia_progenitor_strong_integration_v1}"
SEURAT_RDS="${SEURAT_RDS:-${PROJECT_ROOT}/results/varela_this_paper/varela_this_paper_seurat.rds}"
JIA_SCORES="${JIA_SCORES:-${PROJECT_ROOT}/results/jia_program_div30_scoring/jia_program_div30_scoring_v1/tables/div30_jia_program_scores_obs.tsv}"
OUTDIR="${OUTDIR:-${PROJECT_ROOT}/results/div30_jia_progenitor_reclustering/${RUN_LABEL}}"

SEURAT_ASSAY="${SEURAT_ASSAY:-RNA}"
SOURCE_CLUSTER_COL="${SOURCE_CLUSTER_COL:-}"
PROGENITOR_CLUSTERS="${PROGENITOR_CLUSTERS:-0,3,6,7}"
BATCH_COL="${BATCH_COL:-orig.ident}"

NFEATURES="${NFEATURES:-3000}"
INTEGRATION_NFEATURES="${INTEGRATION_NFEATURES:-5000}"
NPCS="${NPCS:-60}"
DIMS="${DIMS:-50}"
RESOLUTION="${RESOLUTION:-0.8}"
SEED="${SEED:-7}"
INTEGRATION_REDUCTION="${INTEGRATION_REDUCTION:-cca}"
K_ANCHOR="${K_ANCHOR:-10}"
K_WEIGHT="${K_WEIGHT:-200}"
FUTURE_GLOBALS_MAX_GB="${FUTURE_GLOBALS_MAX_GB:-120}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${OUTDIR}"

echo "=== DIV30 Jia progenitor strong integration Slurm context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "CONDA_ENV_BIN=${CONDA_ENV_BIN}"
echo "RSCRIPT=${RSCRIPT}"
echo "RUN_LABEL=${RUN_LABEL}"
echo "SEURAT_RDS=${SEURAT_RDS}"
echo "JIA_SCORES=${JIA_SCORES}"
echo "OUTDIR=${OUTDIR}"
echo "SEURAT_ASSAY=${SEURAT_ASSAY}"
echo "SOURCE_CLUSTER_COL=${SOURCE_CLUSTER_COL:-auto}"
echo "PROGENITOR_CLUSTERS=${PROGENITOR_CLUSTERS}"
echo "BATCH_COL=${BATCH_COL}"
echo "NFEATURES=${NFEATURES}"
echo "INTEGRATION_NFEATURES=${INTEGRATION_NFEATURES}"
echo "NPCS=${NPCS}"
echo "DIMS=${DIMS}"
echo "RESOLUTION=${RESOLUTION}"
echo "SEED=${SEED}"
echo "INTEGRATION_REDUCTION=${INTEGRATION_REDUCTION}"
echo "K_ANCHOR=${K_ANCHOR}"
echo "K_WEIGHT=${K_WEIGHT}"
echo "FUTURE_GLOBALS_MAX_GB=${FUTURE_GLOBALS_MAX_GB}"

export PATH="${CONDA_ENV_BIN}:${PATH}"

echo "Rscript: $("${RSCRIPT}" --version 2>&1 | head -n 1)"
which Rscript

"${RSCRIPT}" -e 'pkgs <- c("Seurat", "SeuratObject", "ggplot2", "patchwork"); status <- sapply(pkgs, requireNamespace, quietly=TRUE); print(data.frame(package=pkgs, installed=status), row.names=FALSE); quit(status=ifelse(all(status), 0, 1))'
"${RSCRIPT}" -e "invisible(parse(file='${REPO_ROOT}/scripts/31_div30_jia_progenitor_strong_integration.R')); cat('R parse ok\n')"

"${RSCRIPT}" "${REPO_ROOT}/scripts/31_div30_jia_progenitor_strong_integration.R" \
  --project-root "${PROJECT_ROOT}" \
  --seurat-rds "${SEURAT_RDS}" \
  --jia-scores "${JIA_SCORES}" \
  --outdir "${OUTDIR}" \
  --run-label "${RUN_LABEL}" \
  --assay "${SEURAT_ASSAY}" \
  --source-cluster-col "${SOURCE_CLUSTER_COL}" \
  --progenitor-clusters "${PROGENITOR_CLUSTERS}" \
  --batch-col "${BATCH_COL}" \
  --nfeatures "${NFEATURES}" \
  --integration-nfeatures "${INTEGRATION_NFEATURES}" \
  --npcs "${NPCS}" \
  --dims "${DIMS}" \
  --resolution "${RESOLUTION}" \
  --seed "${SEED}" \
  --integration-reduction "${INTEGRATION_REDUCTION}" \
  --k-anchor "${K_ANCHOR}" \
  --k-weight "${K_WEIGHT}" \
  --future-globals-max-gb "${FUTURE_GLOBALS_MAX_GB}"

echo "=== DIV30 Jia progenitor strong integration complete ==="
date
find "${OUTDIR}" -maxdepth 3 -type f | sort
