#!/usr/bin/env bash
# Prepare DIV90 neuron query manifests and figure-A heatmaps for Siletti mapping.
#
# Submit:
#   cp slurm_templates/40_prepare_siletti_div90_transfer_inputs.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/40_prepare_siletti_div90_transfer_inputs.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/40_prepare_siletti_div90_transfer_inputs.sbatch

#SBATCH --job-name=siletti-div90-prep
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-div90-prep-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-div90-prep-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
SILETTI_DIV90_PREP_RUN_LABEL="${SILETTI_DIV90_PREP_RUN_LABEL:-siletti_div90_neuron_prep_v1}"
SILETTI_DIV90_TOP_DE_GENES_PER_CLASS="${SILETTI_DIV90_TOP_DE_GENES_PER_CLASS:-8}"
SILETTI_DIV90_MAX_HEATMAP_GENES="${SILETTI_DIV90_MAX_HEATMAP_GENES:-120}"
SILETTI_DIV90_DE_METHOD="${SILETTI_DIV90_DE_METHOD:-wilcoxon}"
SILETTI_DIV90_SEED="${SILETTI_DIV90_SEED:-0}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

echo "Siletti DIV90 transfer prep started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Run label: ${SILETTI_DIV90_PREP_RUN_LABEL}"
echo "Top DE genes per class: ${SILETTI_DIV90_TOP_DE_GENES_PER_CLASS}"
echo "Max heatmap genes: ${SILETTI_DIV90_MAX_HEATMAP_GENES}"
echo "DE method: ${SILETTI_DIV90_DE_METHOD}"
echo "Seed: ${SILETTI_DIV90_SEED}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/python" -m py_compile python_notebooks/scripts/prepare_siletti_div90_transfer_inputs.py

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/prepare_siletti_div90_transfer_inputs.py \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${SILETTI_DIV90_PREP_RUN_LABEL}" \
  --top-de-genes-per-class "${SILETTI_DIV90_TOP_DE_GENES_PER_CLASS}" \
  --max-heatmap-genes "${SILETTI_DIV90_MAX_HEATMAP_GENES}" \
  --de-method "${SILETTI_DIV90_DE_METHOD}" \
  --seed "${SILETTI_DIV90_SEED}"

RUN_DIR="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_DIV90_PREP_RUN_LABEL}"
echo "Generated files:"
find "${RUN_DIR}" -maxdepth 3 -type f | sort
echo "Siletti DIV90 transfer prep finished: $(date)"
