#!/bin/bash
# Publish explicit DIV30 progenitor sample-only and sample+cell-line outputs.
#
# Submit:
#   cp slurm_templates/39_div30_jia_progenitor_sample_and_cellline_outputs.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/39_div30_jia_progenitor_sample_and_cellline_outputs.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/39_div30_jia_progenitor_sample_and_cellline_outputs.sbatch

#SBATCH --job-name=div30_prog_both
#SBATCH --time=03:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=175G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/39_div30_jia_progenitor_sample_and_cellline_outputs_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/39_div30_jia_progenitor_sample_and_cellline_outputs_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_div30_progenitor}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
RSCRIPT="${RSCRIPT:-${CONDA_ENV_BIN}/Rscript}"

SOURCE_DIR="${SOURCE_DIR:-${PROJECT_ROOT}/results/div30_jia_progenitor_reclustering/div30_jia_progenitor_strong_integration_v1}"
SAMPLE_OUTDIR="${SAMPLE_OUTDIR:-${PROJECT_ROOT}/results/div30_jia_progenitor_reclustering/div30_jia_progenitor_sample_integration_v1}"
SAMPLE_CELLLINE_OUTDIR="${SAMPLE_CELLLINE_OUTDIR:-${PROJECT_ROOT}/results/div30_jia_progenitor_reclustering/div30_jia_progenitor_sample_plus_cellline_correction_v1}"
SAMPLE_MAP="${SAMPLE_MAP:-${REPO_ROOT}/metadata/div30_div90_sample_id_to_biolabel_map.tsv}"
SAMPLE_COL="${SAMPLE_COL:-orig.ident}"

NPCS="${NPCS:-60}"
DIMS="${DIMS:-50}"
RESOLUTION="${RESOLUTION:-0.8}"
SEED="${SEED:-7}"
POINT_SIZE="${POINT_SIZE:-0.30}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"

echo "=== DIV30 Jia progenitor sample and cell-line outputs context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "SOURCE_DIR=${SOURCE_DIR}"
echo "SAMPLE_OUTDIR=${SAMPLE_OUTDIR}"
echo "SAMPLE_CELLLINE_OUTDIR=${SAMPLE_CELLLINE_OUTDIR}"
echo "SAMPLE_MAP=${SAMPLE_MAP}"
echo "SAMPLE_COL=${SAMPLE_COL}"
echo "NPCS=${NPCS}"
echo "DIMS=${DIMS}"
echo "RESOLUTION=${RESOLUTION}"
echo "SEED=${SEED}"
echo "POINT_SIZE=${POINT_SIZE}"

export PATH="${CONDA_ENV_BIN}:${PATH}"

"${RSCRIPT}" -e 'pkgs <- c("Seurat", "SeuratObject", "ggplot2", "patchwork"); status <- sapply(pkgs, requireNamespace, quietly=TRUE); print(data.frame(package=pkgs, installed=status), row.names=FALSE); quit(status=ifelse(all(status), 0, 1))'
"${RSCRIPT}" -e "invisible(parse(file='${REPO_ROOT}/scripts/32_div30_jia_progenitor_publish_sample_and_cellline_outputs.R')); cat('R parse ok\n')"

"${RSCRIPT}" "${REPO_ROOT}/scripts/32_div30_jia_progenitor_publish_sample_and_cellline_outputs.R" \
  --project-root "${PROJECT_ROOT}" \
  --source-dir "${SOURCE_DIR}" \
  --sample-outdir "${SAMPLE_OUTDIR}" \
  --sample-cellline-outdir "${SAMPLE_CELLLINE_OUTDIR}" \
  --sample-map "${SAMPLE_MAP}" \
  --sample-col "${SAMPLE_COL}" \
  --npcs "${NPCS}" \
  --dims "${DIMS}" \
  --resolution "${RESOLUTION}" \
  --seed "${SEED}" \
  --point-size "${POINT_SIZE}"

echo "=== DIV30 Jia progenitor sample and cell-line outputs complete ==="
date
find "${SAMPLE_OUTDIR}" "${SAMPLE_CELLLINE_OUTDIR}" -maxdepth 3 -type f | sort
