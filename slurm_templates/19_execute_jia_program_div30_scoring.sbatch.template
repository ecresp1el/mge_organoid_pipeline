#!/usr/bin/env bash
# Execute the standalone Jia program scoring notebook for DIV30.
#
# Submit:
#   cp slurm_templates/19_execute_jia_program_div30_scoring.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/19_execute_jia_program_div30_scoring.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/19_execute_jia_program_div30_scoring.sbatch

#SBATCH --job-name=jia-prog-div30
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --time=08:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/jia-program-div30-%x-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/jia-program-div30-%x-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"

JIA_PROGRAM_RESULTS_DIRNAME="${JIA_PROGRAM_RESULTS_DIRNAME:-jia_program_div30_scoring}"
JIA_PROGRAM_RUN_LABEL="${JIA_PROGRAM_RUN_LABEL:-jia_program_div30_scoring_v1}"
JIA_PROGRAM_STUDY_ID="${JIA_PROGRAM_STUDY_ID:-varela_div30}"
JIA_PROGRAM_CSV="${JIA_PROGRAM_CSV:-${PROJECT_ROOT}/reference/Jia_et_al_2026_Science_3_progs.csv}"
JIA_PROGRAM_H5AD="${JIA_PROGRAM_H5AD:-${PROJECT_ROOT}/results/python_anndata/varela_div30.h5ad}"
JIA_PROGRAM_RESOLUTION_ASSIGNMENTS="${JIA_PROGRAM_RESOLUTION_ASSIGNMENTS:-${PROJECT_ROOT}/results/seurat_cluster_resolution_sweep/seurat_cluster_resolution_sweep_v1/varela_div30/tables/resolution_sweep_cluster_assignments_wide.tsv}"
JIA_PROGRAM_ORDER="${JIA_PROGRAM_ORDER:-IPC,RGC1,RGC2}"
JIA_PROGRAM_TOP_N="${JIA_PROGRAM_TOP_N:-}"
JIA_PROGRAM_MIN_AVG_LOG2FC="${JIA_PROGRAM_MIN_AVG_LOG2FC:-}"
JIA_PROGRAM_MAX_P_VAL_ADJ="${JIA_PROGRAM_MAX_P_VAL_ADJ:-}"
JIA_PROGRAM_CTRL_SIZE="${JIA_PROGRAM_CTRL_SIZE:-50}"
JIA_PROGRAM_RANDOM_STATE="${JIA_PROGRAM_RANDOM_STATE:-0}"
JIA_PROGRAM_HIGH_SCORE_QUANTILE="${JIA_PROGRAM_HIGH_SCORE_QUANTILE:-0.9}"
JIA_PROGRAM_SAVE_PLOTS="${JIA_PROGRAM_SAVE_PLOTS:-1}"
JIA_PROGRAM_SHOW_PLOTS="${JIA_PROGRAM_SHOW_PLOTS:-0}"

executed_dir="${PROJECT_ROOT}/results/${JIA_PROGRAM_RESULTS_DIRNAME}/executed"
executed_name="jia_program_div30_scoring.${JIA_PROGRAM_RUN_LABEL}.executed.ipynb"
executed_path="${executed_dir}/${executed_name}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${executed_dir}"

cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"
export JIA_PROGRAM_RESULTS_DIRNAME
export JIA_PROGRAM_RUN_LABEL
export JIA_PROGRAM_STUDY_ID
export JIA_PROGRAM_CSV
export JIA_PROGRAM_H5AD
export JIA_PROGRAM_RESOLUTION_ASSIGNMENTS
export JIA_PROGRAM_ORDER
export JIA_PROGRAM_TOP_N
export JIA_PROGRAM_MIN_AVG_LOG2FC
export JIA_PROGRAM_MAX_P_VAL_ADJ
export JIA_PROGRAM_CTRL_SIZE
export JIA_PROGRAM_RANDOM_STATE
export JIA_PROGRAM_HIGH_SCORE_QUANTILE
export JIA_PROGRAM_SAVE_PLOTS
export JIA_PROGRAM_SHOW_PLOTS

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Run label: ${JIA_PROGRAM_RUN_LABEL}"
echo "Study ID: ${JIA_PROGRAM_STUDY_ID}"
echo "Marker CSV: ${JIA_PROGRAM_CSV}"
echo "AnnData input: ${JIA_PROGRAM_H5AD}"
echo "Resolution assignments: ${JIA_PROGRAM_RESOLUTION_ASSIGNMENTS}"
echo "Program order: ${JIA_PROGRAM_ORDER}"
echo "Top N per program: ${JIA_PROGRAM_TOP_N:-all}"
echo "Min avg_log2FC: ${JIA_PROGRAM_MIN_AVG_LOG2FC:-none}"
echo "Max p_val_adj: ${JIA_PROGRAM_MAX_P_VAL_ADJ:-none}"
echo "Scanpy ctrl_size: ${JIA_PROGRAM_CTRL_SIZE}"
echo "Random state: ${JIA_PROGRAM_RANDOM_STATE}"
echo "High-score quantile: ${JIA_PROGRAM_HIGH_SCORE_QUANTILE}"
echo "Save plots: ${JIA_PROGRAM_SAVE_PLOTS}"
echo "Show plots in executed notebook: ${JIA_PROGRAM_SHOW_PLOTS}"
echo "Executed notebook: ${executed_path}"
echo "jupyter: $("${CONDA_ENV_BIN}/jupyter" --version 2>/dev/null | head -n 1)"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/jupyter" nbconvert \
  --to notebook \
  --execute python_notebooks/notebooks/jia_program_div30_scoring.ipynb \
  --output-dir "${executed_dir}" \
  --output "${executed_name}" \
  --ExecutePreprocessor.kernel_name=mge-organoid-python \
  --ExecutePreprocessor.timeout=-1

echo "Jia program scoring completion lines from executed notebook:"
EXECUTED_NOTEBOOK_PATH="${executed_path}" "${CONDA_ENV_BIN}/python" <<'PY'
import json
import os
from pathlib import Path

marker = "[JiaProgramScoring]"
path = Path(os.environ["EXECUTED_NOTEBOOK_PATH"])
nb = json.loads(path.read_text())
matched = 0
complete = False
for cell in nb.get("cells", []):
    for output in cell.get("outputs", []):
        if output.get("output_type") != "stream":
            continue
        text = output.get("text", "")
        if isinstance(text, list):
            text = "".join(text)
        for line in text.splitlines():
            if marker in line:
                print(line)
                matched += 1
                if "complete" in line:
                    complete = True
print(f"JiaProgramScoring marker line count: {matched}")
if not complete:
    raise SystemExit(f"No completion marker found in {path}")
PY

echo "Job finished: $(date)"
