#!/usr/bin/env bash
# Stage Siletti/CELLxGENE adult human brain supercluster H5ADs for DIV90 mapping.
#
# Submit:
#   cp slurm_templates/39_fetch_siletti_cellxgene_supercluster_h5ads.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/39_fetch_siletti_cellxgene_supercluster_h5ads.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/39_fetch_siletti_cellxgene_supercluster_h5ads.sbatch

#SBATCH --job-name=siletti-fetch-h5ad
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-fetch-h5ad-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-fetch-h5ad-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"
SILETTI_FETCH_OVERWRITE="${SILETTI_FETCH_OVERWRITE:-0}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

echo "Siletti CELLxGENE supercluster H5AD staging started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Overwrite: ${SILETTI_FETCH_OVERWRITE}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/python" -m py_compile python_notebooks/scripts/fetch_siletti_cellxgene_supercluster_h5ads.py

args=(--project-root "${PROJECT_ROOT}")
if [[ "${SILETTI_FETCH_OVERWRITE}" == "1" ]]; then
  args+=(--overwrite)
fi

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/fetch_siletti_cellxgene_supercluster_h5ads.py "${args[@]}"

echo "Generated source files:"
find "${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/source_cellxgene_superclusters" -maxdepth 3 -type f | sort
echo "Siletti CELLxGENE supercluster H5AD staging finished: $(date)"
