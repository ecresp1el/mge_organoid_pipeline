#!/bin/bash
#SBATCH --job-name=download_extra_geo
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --nodes=1
#SBATCH --output=${PROJECT_ROOT}/logs/01c_download_extra_geo_%j.log
#SBATCH --error=${PROJECT_ROOT}/logs/01c_download_extra_geo_%j.log
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=your_email@umich.edu
#SBATCH --account=parent0
#SBATCH --partition=standard

# Template for downloading GEO datasets GSE97882 (Xiang_2018) and GSE165577 (Samarasinghe_2021).
# Fill REPO_ROOT and PROJECT_ROOT before submission.
REPO_ROOT="/path/to/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"

set -euo pipefail

mkdir -p "${PROJECT_ROOT}/logs"

export PROJECT_ROOT
"${REPO_ROOT}/scripts/01c_download_extra_geo.sh" --project-root "${PROJECT_ROOT}"
