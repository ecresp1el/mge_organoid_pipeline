#!/usr/bin/env bash
# Run forced Jia-style integration for adult Siletti MGE/LLC reference cells
# and DIV90 neuron-lineage query cells.
#
# Submit:
#   cp slurm_templates/52_siletti_div90_forced_jia_style_integration.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/52_siletti_div90_forced_jia_style_integration.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/52_siletti_div90_forced_jia_style_integration.sbatch

#SBATCH --job-name=siletti-forced-jia
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-forced-jia-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-forced-jia-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"

SILETTI_FORCED_RUN_LABEL="${SILETTI_FORCED_RUN_LABEL:-forced_jia_style_integration_adult_div90}"
SILETTI_BRIDGE_RUN_LABEL="${SILETTI_BRIDGE_RUN_LABEL:-siletti_div90_seurat_bridge_v1}"
SILETTI_TRANSFER_RUN_LABEL="${SILETTI_TRANSFER_RUN_LABEL:-siletti_div90_fast_knn_transfer_full_mge_llc_v1}"
SILETTI_TRANSFER_SCOPE="${SILETTI_TRANSFER_SCOPE:-mge_llc}"
SILETTI_TRANSFER_N_COMPONENTS="${SILETTI_TRANSFER_N_COMPONENTS:-50}"
SILETTI_TRANSFER_K="${SILETTI_TRANSFER_K:-50}"
SILETTI_TRANSFER_MAX_REFERENCE_CELLS="${SILETTI_TRANSFER_MAX_REFERENCE_CELLS:-0}"
SILETTI_TRANSFER_MAX_QUERY_CELLS="${SILETTI_TRANSFER_MAX_QUERY_CELLS:-0}"

SILETTI_FORCED_LABEL_COLUMN="${SILETTI_FORCED_LABEL_COLUMN:-candidate_jia_group}"
SILETTI_FORCED_EXCLUDE_LABEL="${SILETTI_FORCED_EXCLUDE_LABEL:-Excluded / not assigned to Jia-style 9 groups}"
SILETTI_FORCED_QUERY_CLASS_COL="${SILETTI_FORCED_QUERY_CLASS_COL:-div90_broad_class}"
SILETTI_FORCED_NFEATURES="${SILETTI_FORCED_NFEATURES:-3000}"
SILETTI_FORCED_N_COMPONENTS="${SILETTI_FORCED_N_COMPONENTS:-50}"
SILETTI_FORCED_HARMONY_THETA="${SILETTI_FORCED_HARMONY_THETA:-2.0}"
SILETTI_FORCED_HARMONY_LAMBDA="${SILETTI_FORCED_HARMONY_LAMBDA:-1.0}"
SILETTI_FORCED_HARMONY_MAX_ITER="${SILETTI_FORCED_HARMONY_MAX_ITER:-20}"
SILETTI_FORCED_HARMONY_MAX_ITER_KMEANS="${SILETTI_FORCED_HARMONY_MAX_ITER_KMEANS:-50}"
SILETTI_FORCED_HARMONY_EPSILON_CLUSTER="${SILETTI_FORCED_HARMONY_EPSILON_CLUSTER:-1e-5}"
SILETTI_FORCED_HARMONY_EPSILON_HARMONY="${SILETTI_FORCED_HARMONY_EPSILON_HARMONY:-1e-5}"
SILETTI_FORCED_BBKNN_NEIGHBORS_WITHIN_BATCH="${SILETTI_FORCED_BBKNN_NEIGHBORS_WITHIN_BATCH:-25}"
SILETTI_FORCED_BBKNN_N_PCS="${SILETTI_FORCED_BBKNN_N_PCS:-50}"
SILETTI_FORCED_BBKNN_METRIC="${SILETTI_FORCED_BBKNN_METRIC:-euclidean}"
SILETTI_FORCED_BBKNN_TRIM="${SILETTI_FORCED_BBKNN_TRIM:-0}"
SILETTI_FORCED_BBKNN_COMPUTATION="${SILETTI_FORCED_BBKNN_COMPUTATION:-annoy}"
SILETTI_FORCED_BBKNN_ANNOY_N_TREES="${SILETTI_FORCED_BBKNN_ANNOY_N_TREES:-50}"
SILETTI_FORCED_UMAP_MIN_DIST="${SILETTI_FORCED_UMAP_MIN_DIST:-0.5}"
SILETTI_FORCED_UMAP_SPREAD="${SILETTI_FORCED_UMAP_SPREAD:-1.0}"
SILETTI_FORCED_SEED="${SILETTI_FORCED_SEED:-0}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

bridge_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_BRIDGE_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/seurat_bridge"
transfer_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_TRANSFER_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/svd${SILETTI_TRANSFER_N_COMPONENTS}_k${SILETTI_TRANSFER_K}_ref${SILETTI_TRANSFER_MAX_REFERENCE_CELLS}_query${SILETTI_TRANSFER_MAX_QUERY_CELLS}"
outdir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_FORCED_RUN_LABEL}"

echo "Siletti DIV90 forced Jia-style integration job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Bridge dir: ${bridge_dir}"
echo "Transfer dir: ${transfer_dir}"
echo "Output dir: ${outdir}"
echo "Label column: ${SILETTI_FORCED_LABEL_COLUMN}"
echo "Query class column: ${SILETTI_FORCED_QUERY_CLASS_COL}"
echo "Features/components: ${SILETTI_FORCED_NFEATURES}/${SILETTI_FORCED_N_COMPONENTS}"
echo "Harmony theta/lambda/max_iter: ${SILETTI_FORCED_HARMONY_THETA}/${SILETTI_FORCED_HARMONY_LAMBDA}/${SILETTI_FORCED_HARMONY_MAX_ITER}"
echo "BBKNN neighbors_within_batch/n_pcs/metric/trim/computation: ${SILETTI_FORCED_BBKNN_NEIGHBORS_WITHIN_BATCH}/${SILETTI_FORCED_BBKNN_N_PCS}/${SILETTI_FORCED_BBKNN_METRIC}/${SILETTI_FORCED_BBKNN_TRIM}/${SILETTI_FORCED_BBKNN_COMPUTATION}"
echo "UMAP min.dist/spread: ${SILETTI_FORCED_UMAP_MIN_DIST}/${SILETTI_FORCED_UMAP_SPREAD}"
echo "Seed: ${SILETTI_FORCED_SEED}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/python" -m py_compile python_notebooks/scripts/plot_siletti_div90_forced_jia_style_integration.py

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/plot_siletti_div90_forced_jia_style_integration.py \
  --bridge-dir "${bridge_dir}" \
  --transfer-dir "${transfer_dir}" \
  --outdir "${outdir}" \
  --label-column "${SILETTI_FORCED_LABEL_COLUMN}" \
  --exclude-label "${SILETTI_FORCED_EXCLUDE_LABEL}" \
  --query-class-col "${SILETTI_FORCED_QUERY_CLASS_COL}" \
  --nfeatures "${SILETTI_FORCED_NFEATURES}" \
  --n-components "${SILETTI_FORCED_N_COMPONENTS}" \
  --harmony-theta "${SILETTI_FORCED_HARMONY_THETA}" \
  --harmony-lambda "${SILETTI_FORCED_HARMONY_LAMBDA}" \
  --harmony-max-iter "${SILETTI_FORCED_HARMONY_MAX_ITER}" \
  --harmony-max-iter-kmeans "${SILETTI_FORCED_HARMONY_MAX_ITER_KMEANS}" \
  --harmony-epsilon-cluster "${SILETTI_FORCED_HARMONY_EPSILON_CLUSTER}" \
  --harmony-epsilon-harmony "${SILETTI_FORCED_HARMONY_EPSILON_HARMONY}" \
  --bbknn-neighbors-within-batch "${SILETTI_FORCED_BBKNN_NEIGHBORS_WITHIN_BATCH}" \
  --bbknn-n-pcs "${SILETTI_FORCED_BBKNN_N_PCS}" \
  --bbknn-metric "${SILETTI_FORCED_BBKNN_METRIC}" \
  --bbknn-trim "${SILETTI_FORCED_BBKNN_TRIM}" \
  --bbknn-computation "${SILETTI_FORCED_BBKNN_COMPUTATION}" \
  --bbknn-annoy-n-trees "${SILETTI_FORCED_BBKNN_ANNOY_N_TREES}" \
  --umap-min-dist "${SILETTI_FORCED_UMAP_MIN_DIST}" \
  --umap-spread "${SILETTI_FORCED_UMAP_SPREAD}" \
  --seed "${SILETTI_FORCED_SEED}"

echo "Generated files:"
find "${outdir}" -maxdepth 3 -type f | sort
echo "Siletti DIV90 forced Jia-style integration job finished: $(date)"
