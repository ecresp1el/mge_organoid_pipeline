#!/bin/bash
# Panel B template pinned to Seurat v4 runtime.
# If your config includes Assay5 objects, use
# slurm_templates/06_cross_study_panelB_markers_seurat5.sbatch.template instead.
#SBATCH --job-name=panelb_markers
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/06_panelb_markers_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/06_panelb_markers_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

module load Bioinformatics
module load r-seurat/4.1.1-R-4.2.0-5z5hgo7

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
CONFIG_PATH="${REPO_ROOT}/config/panel_b_cross_study_config.example.R"
RUN_LABEL="panel_b_cross_study_v1"
DETAILED_LOG="true"
SHOW_PROGRESS="false"
RETAIN_SEURAT="false"
WRITE_PREPARED="true"
WRITE_STUDY_OBJECTS="true"
PREPARED_OBJECTS_ROOT="results/panel_b_prepared_objects"

set -euo pipefail
set -x
mkdir -p "${PROJECT_ROOT}/logs"

echo "=== Panel B job context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_JOB_NAME=${SLURM_JOB_NAME:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "SLURM_MEM_PER_NODE=${SLURM_MEM_PER_NODE:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "CONFIG_PATH=${CONFIG_PATH}"
echo "RUN_LABEL=${RUN_LABEL}"
echo "DETAILED_LOG=${DETAILED_LOG}"
echo "SHOW_PROGRESS=${SHOW_PROGRESS}"
echo "RETAIN_SEURAT=${RETAIN_SEURAT}"
echo "WRITE_PREPARED=${WRITE_PREPARED}"
echo "WRITE_STUDY_OBJECTS=${WRITE_STUDY_OBJECTS}"
echo "PREPARED_OBJECTS_ROOT=${PREPARED_OBJECTS_ROOT}"
module list 2>&1

export PROJECT_ROOT
Rscript "${REPO_ROOT}/scripts/06_cross_study_panelB_markers.R" \
  --config "${CONFIG_PATH}" \
  --project-root "${PROJECT_ROOT}" \
  --run-label "${RUN_LABEL}" \
  --detailed-log "${DETAILED_LOG}" \
  --show-progress "${SHOW_PROGRESS}" \
  --retain-seurat "${RETAIN_SEURAT}" \
  --write-prepared "${WRITE_PREPARED}" \
  --write-study-objects "${WRITE_STUDY_OBJECTS}" \
  --prepared-objects-root "${PREPARED_OBJECTS_ROOT}"
