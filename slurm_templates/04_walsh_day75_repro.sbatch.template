#!/bin/bash
#SBATCH --job-name=walsh_d75_repro
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/04_walsh_d75_repro_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/04_walsh_d75_repro_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0
## #SBATCH --mail-type=FAIL
## #SBATCH --mail-user=you@umich.edu

# NOTE: Script enforces R 4.1.x and Seurat 4.2.0 at runtime; adjust modules to match.
module load Bioinformatics
module load r-seurat/4.1.1-R-4.2.0-5z5hgo7

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
HYPOXIA_GENES="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline/metadata/walsh_hypoxia_genes.txt"
GLYCOLYSIS_GENES="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline/metadata/walsh_glycolysis_genes.txt"

set -euo pipefail
mkdir -p "${PROJECT_ROOT}/logs"

export PROJECT_ROOT HYPOXIA_GENES GLYCOLYSIS_GENES
Rscript "${REPO_ROOT}/scripts/04_walsh_day75_repro.R" \
  --project-root "${PROJECT_ROOT}" \
  --hypoxia-genes "${HYPOXIA_GENES}" \
  --glycolysis-genes "${GLYCOLYSIS_GENES}"
