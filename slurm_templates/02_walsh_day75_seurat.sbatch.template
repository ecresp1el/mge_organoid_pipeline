set -euo pipefail
mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/results/walsh_day75" "${PROJECT_ROOT}/data/processed/walsh_day75/raw_extract"

export PROJECT_ROOT
