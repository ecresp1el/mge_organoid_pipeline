#!/bin/bash
#SBATCH --job-name=walsh_d75_seurat
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --nodes=1
#SBATCH --output=${PROJECT_ROOT}/logs/02_walsh_day75_%j.log
