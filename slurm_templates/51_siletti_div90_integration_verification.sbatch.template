#!/usr/bin/env bash
# Verify unintegrated and Harmony Siletti/DIV90 integration outputs.
#
# Submit:
#   cp slurm_templates/51_siletti_div90_integration_verification.sbatch.template \
#     /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/51_siletti_div90_integration_verification.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/51_siletti_div90_integration_verification.sbatch

#SBATCH --job-name=siletti-verify
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-verify-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/siletti-verify-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"

SILETTI_VERIFY_RUN_LABEL="${SILETTI_VERIFY_RUN_LABEL:-integration_sensitivity_diagnostics_adult_div90}"
SILETTI_UNINTEGRATED_RUN_LABEL="${SILETTI_UNINTEGRATED_RUN_LABEL:-unintegrated_joint_embedding_adult_div90}"
SILETTI_HARMONY_RUN_LABEL="${SILETTI_HARMONY_RUN_LABEL:-harmony_integrated_adult_div90}"
SILETTI_BRIDGE_RUN_LABEL="${SILETTI_BRIDGE_RUN_LABEL:-siletti_div90_seurat_bridge_v1}"
SILETTI_TRANSFER_RUN_LABEL="${SILETTI_TRANSFER_RUN_LABEL:-siletti_div90_fast_knn_transfer_full_mge_llc_v1}"
SILETTI_TRANSFER_SCOPE="${SILETTI_TRANSFER_SCOPE:-mge_llc}"
SILETTI_TRANSFER_N_COMPONENTS="${SILETTI_TRANSFER_N_COMPONENTS:-50}"
SILETTI_TRANSFER_K="${SILETTI_TRANSFER_K:-50}"
SILETTI_TRANSFER_MAX_REFERENCE_CELLS="${SILETTI_TRANSFER_MAX_REFERENCE_CELLS:-0}"
SILETTI_TRANSFER_MAX_QUERY_CELLS="${SILETTI_TRANSFER_MAX_QUERY_CELLS:-0}"

SILETTI_VERIFY_LABEL_COLUMN="${SILETTI_VERIFY_LABEL_COLUMN:-candidate_jia_group}"
SILETTI_VERIFY_EXCLUDE_LABEL="${SILETTI_VERIFY_EXCLUDE_LABEL:-Excluded / not assigned to Jia-style 9 groups}"
SILETTI_VERIFY_QUERY_CLASS_COL="${SILETTI_VERIFY_QUERY_CLASS_COL:-div90_broad_class}"
SILETTI_VERIFY_NFEATURES="${SILETTI_VERIFY_NFEATURES:-3000}"
SILETTI_VERIFY_N_COMPONENTS="${SILETTI_VERIFY_N_COMPONENTS:-50}"
SILETTI_VERIFY_SOURCE_MIXING_K="${SILETTI_VERIFY_SOURCE_MIXING_K:-50}"
SILETTI_VERIFY_HARMONY_THETA="${SILETTI_VERIFY_HARMONY_THETA:-2.0}"
SILETTI_VERIFY_HARMONY_LAMBDA="${SILETTI_VERIFY_HARMONY_LAMBDA:-1.0}"
SILETTI_VERIFY_HARMONY_MAX_ITER="${SILETTI_VERIFY_HARMONY_MAX_ITER:-20}"
SILETTI_VERIFY_SEED="${SILETTI_VERIFY_SEED:-0}"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs"
cd "${REPO_ROOT}"

export PROJECT_ROOT
export PATH="${CONDA_ENV_BIN}:${PATH}"
export PYTHONPATH="${REPO_ROOT}/python_notebooks/src:${PYTHONPATH:-}"

bridge_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_BRIDGE_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/seurat_bridge"
transfer_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_TRANSFER_RUN_LABEL}/${SILETTI_TRANSFER_SCOPE}/svd${SILETTI_TRANSFER_N_COMPONENTS}_k${SILETTI_TRANSFER_K}_ref${SILETTI_TRANSFER_MAX_REFERENCE_CELLS}_query${SILETTI_TRANSFER_MAX_QUERY_CELLS}"
unintegrated_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_UNINTEGRATED_RUN_LABEL}"
harmony_dir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_HARMONY_RUN_LABEL}"
outdir="${PROJECT_ROOT}/results/siletti_2023_whb_reference_label_transfer/${SILETTI_VERIFY_RUN_LABEL}"

echo "Siletti DIV90 integration verification started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Bridge dir: ${bridge_dir}"
echo "Transfer dir: ${transfer_dir}"
echo "Unintegrated dir: ${unintegrated_dir}"
echo "Harmony dir: ${harmony_dir}"
echo "Output dir: ${outdir}"
echo "Source mixing k: ${SILETTI_VERIFY_SOURCE_MIXING_K}"
echo "python: $("${CONDA_ENV_BIN}/python" --version)"

"${CONDA_ENV_BIN}/python" -m py_compile python_notebooks/scripts/summarize_siletti_div90_integration_diagnostics.py

"${CONDA_ENV_BIN}/python" python_notebooks/scripts/summarize_siletti_div90_integration_diagnostics.py \
  --bridge-dir "${bridge_dir}" \
  --transfer-dir "${transfer_dir}" \
  --unintegrated-dir "${unintegrated_dir}" \
  --harmony-dir "${harmony_dir}" \
  --outdir "${outdir}" \
  --label-column "${SILETTI_VERIFY_LABEL_COLUMN}" \
  --exclude-label "${SILETTI_VERIFY_EXCLUDE_LABEL}" \
  --query-class-col "${SILETTI_VERIFY_QUERY_CLASS_COL}" \
  --nfeatures "${SILETTI_VERIFY_NFEATURES}" \
  --n-components "${SILETTI_VERIFY_N_COMPONENTS}" \
  --source-mixing-k "${SILETTI_VERIFY_SOURCE_MIXING_K}" \
  --harmony-theta "${SILETTI_VERIFY_HARMONY_THETA}" \
  --harmony-lambda "${SILETTI_VERIFY_HARMONY_LAMBDA}" \
  --harmony-max-iter "${SILETTI_VERIFY_HARMONY_MAX_ITER}" \
  --seed "${SILETTI_VERIFY_SEED}"

echo "Generated files:"
find "${outdir}" -maxdepth 3 -type f | sort
echo "Siletti DIV90 integration verification finished: $(date)"
