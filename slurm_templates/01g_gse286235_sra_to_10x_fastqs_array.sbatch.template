#!/bin/bash
#SBATCH --job-name=gse286235_sra_fastq
#SBATCH --time=36:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --nodes=1
#SBATCH --array=1-3
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/01g_gse286235_sra_fastq_%A_%a.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/01g_gse286235_sra_fastq_%A_%a.log
#SBATCH --account=parent0
#SBATCH --partition=standard

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
SRA_MODULE="${SRA_MODULE:-sratoolkit/3.1.1}"

set -euo pipefail

SAMPLES=(BF_H9_D36 BF_H9_D63 BFCO_IMR_D63)
SAMPLE_ID="${SAMPLES[$((SLURM_ARRAY_TASK_ID - 1))]}"

mkdir -p "${PROJECT_ROOT}/logs"

export PROJECT_ROOT REPO_ROOT
echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Sample: ${SAMPLE_ID}"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"

module load Bioinformatics
module load "${SRA_MODULE}"

echo "SRA module: ${SRA_MODULE}"
echo "prefetch: $(prefetch --version 2>&1 | head -n 1)"
echo "fasterq-dump: $(fasterq-dump --version 2>&1 | head -n 1)"

bash "${REPO_ROOT}/scripts/01g_gse286235_sra_to_10x_fastqs.sh" \
  --sample-id "${SAMPLE_ID}" \
  --project-root "${PROJECT_ROOT}" \
  --repo-root "${REPO_ROOT}" \
  --threads "${SLURM_CPUS_PER_TASK}"

echo "Job finished: $(date)"
