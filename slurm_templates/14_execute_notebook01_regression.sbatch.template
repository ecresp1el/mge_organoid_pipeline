#!/usr/bin/env bash
#SBATCH --job-name=exec-nb01-regression
#SBATCH --account=parent0
#SBATCH --partition=standard
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=160G
#SBATCH --time=08:00:00
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/execute-notebook01-%x-%j.out
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/execute-notebook01-%x-%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline}"
PROJECT_ROOT="${PROJECT_ROOT:-/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder}"
CONDA_ENV_BIN="${CONDA_ENV_BIN:-/home/elcrespo/miniconda3/envs/mge-organoid-python/bin}"

NOTEBOOK01_NOTEBOOK00_RUN_LABEL="${NOTEBOOK01_NOTEBOOK00_RUN_LABEL:-cellranger_filtered_manual_ec_div30_core_samples_freeze}"
NOTEBOOK01_RUN_LABEL="${NOTEBOOK01_RUN_LABEL:-${NOTEBOOK01_NOTEBOOK00_RUN_LABEL}_qc_regression_v1}"
NOTEBOOK01_SCOPES="${NOTEBOOK01_SCOPES:-combined:per_sample}"
NOTEBOOK01_REGRESS_KEYS="${NOTEBOOK01_REGRESS_KEYS:-total_counts:pct_counts_mt}"
NOTEBOOK01_N_TOP_GENES="${NOTEBOOK01_N_TOP_GENES:-2000}"
NOTEBOOK01_N_PCS="${NOTEBOOK01_N_PCS:-50}"
NOTEBOOK01_N_NEIGHBORS="${NOTEBOOK01_N_NEIGHBORS:-15}"
NOTEBOOK01_LEIDEN_RESOLUTION="${NOTEBOOK01_LEIDEN_RESOLUTION:-0.5}"
NOTEBOOK01_RANDOM_STATE="${NOTEBOOK01_RANDOM_STATE:-0}"
NOTEBOOK01_REGRESS_N_JOBS="${NOTEBOOK01_REGRESS_N_JOBS:-8}"
NOTEBOOK01_SHOW_PLOTS="${NOTEBOOK01_SHOW_PLOTS:-1}"
NOTEBOOK01_SAVE_PLOTS="${NOTEBOOK01_SAVE_PLOTS:-1}"
NOTEBOOK01_WRITE_BRANCH_H5AD="${NOTEBOOK01_WRITE_BRANCH_H5AD:-0}"

executed_dir="${PROJECT_ROOT}/results/notebook01/executed"
executed_name="01_notebook00_checkpoint_regression_comparison.${NOTEBOOK01_RUN_LABEL}.executed.ipynb"

mkdir -p "${PROJECT_ROOT}/logs" "${executed_dir}"

cd "${REPO_ROOT}"

export PROJECT_ROOT
export NOTEBOOK01_NOTEBOOK00_RUN_LABEL
export NOTEBOOK01_RUN_LABEL
export NOTEBOOK01_SCOPES
export NOTEBOOK01_REGRESS_KEYS
export NOTEBOOK01_N_TOP_GENES
export NOTEBOOK01_N_PCS
export NOTEBOOK01_N_NEIGHBORS
export NOTEBOOK01_LEIDEN_RESOLUTION
export NOTEBOOK01_RANDOM_STATE
export NOTEBOOK01_REGRESS_N_JOBS
export NOTEBOOK01_SHOW_PLOTS
export NOTEBOOK01_SAVE_PLOTS
export NOTEBOOK01_WRITE_BRANCH_H5AD

echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "Repo root: ${REPO_ROOT}"
echo "Project/data root: ${PROJECT_ROOT}"
echo "Notebook 00 input run label: ${NOTEBOOK01_NOTEBOOK00_RUN_LABEL}"
echo "Notebook 01 run label: ${NOTEBOOK01_RUN_LABEL}"
echo "Scopes: ${NOTEBOOK01_SCOPES}"
echo "Regression keys: ${NOTEBOOK01_REGRESS_KEYS}"
echo "N top genes: ${NOTEBOOK01_N_TOP_GENES}"
echo "N PCs: ${NOTEBOOK01_N_PCS}"
echo "N neighbors: ${NOTEBOOK01_N_NEIGHBORS}"
echo "Leiden resolution: ${NOTEBOOK01_LEIDEN_RESOLUTION}"
echo "Show plots in executed notebook: ${NOTEBOOK01_SHOW_PLOTS}"
echo "Save plots: ${NOTEBOOK01_SAVE_PLOTS}"
echo "Write branch h5ad: ${NOTEBOOK01_WRITE_BRANCH_H5AD}"
echo "Executed notebook: ${executed_dir}/${executed_name}"

"${CONDA_ENV_BIN}/jupyter" nbconvert \
  --to notebook \
  --execute python_notebooks/notebooks/01_notebook00_checkpoint_regression_comparison.ipynb \
  --output-dir "${executed_dir}" \
  --output "${executed_name}" \
  --ExecutePreprocessor.kernel_name=mge-organoid-python \
  --ExecutePreprocessor.timeout=-1

echo "Job finished: $(date)"
