#!/bin/bash
#SBATCH --job-name=he_extract_lhx6_nkx21
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/05e_he_extract_lhx6_nkx21_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/05e_he_extract_lhx6_nkx21_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

module load Bioinformatics
module load python/3.11.5

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
PYTHON_BIN="${PYTHON_BIN:-python3}"
H5AD_PATH="${PROJECT_ROOT}/data/raw/he_et_al_zenodo/suppl/hnoca_allmeta.h5ad"
OUT_DIR="${PROJECT_ROOT}/data/processed/he_et_al_scn8a_slice"
PY_ENV_DIR="${PROJECT_ROOT}/data/processed/he_et_al_py311_env"

set -euo pipefail
set -x
mkdir -p "${PROJECT_ROOT}/logs"
mkdir -p "${PROJECT_ROOT}/data/processed"

if [[ ! -x "${PY_ENV_DIR}/bin/python" ]]; then
  python3 -m venv "${PY_ENV_DIR}"
fi

if ! "${PY_ENV_DIR}/bin/python" - <<'PY'
import anndata, numpy, pandas, scipy
print("python_deps_ok")
PY
then
  "${PY_ENV_DIR}/bin/python" -m pip install --upgrade pip
  "${PY_ENV_DIR}/bin/python" -m pip install --upgrade anndata numpy pandas scipy
fi

PYTHON_BIN="${PY_ENV_DIR}/bin/python"

"${PYTHON_BIN}" "${REPO_ROOT}/scripts/05e_extract_he_et_al_scn8a_slice.py" \
  --h5ad "${H5AD_PATH}" \
  --outdir "${OUT_DIR}" \
  --genes "SCN8A,LHX6,NKX2.1"
