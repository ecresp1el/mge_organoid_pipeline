#!/bin/bash
# Build and finalize the first DIV30 URD lineage tree from an existing URD
# pseudotime object.
#
# Pipeline logic:
#   1. Read an existing `div30_first_urd_object.rds` from RUN_LABEL.
#   2. Use paper/manual Radial glia cells as the root.
#   3. Use numeric URD tip IDs for:
#        1 = SST+ cIN
#        2 = PV neuron precursor
#        3 = MGE subpallial neurons
#      Numeric IDs are intentional because URD's tree internals expect
#      numeric-like segment names.
#   4. Run:
#        pseudotimeDetermineLogistic()
#        pseudotimeWeightTransitionMatrix()
#        simulateRandomWalksFromTips()
#        processRandomWalksFromTips()
#        buildTree()
#   5. Finalize reports in a fresh R process to avoid carrying the large
#      random-walk/buildTree memory footprint into branch-gene plotting.
#
# Submit:
#   cp slurm_templates/32_div30_urd_lineage_tree.sbatch.template /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/32_div30_urd_lineage_tree.sbatch
#   sbatch /nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/jobs/32_div30_urd_lineage_tree.sbatch

#SBATCH --job-name=div30_urd_tree
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=80G
#SBATCH --nodes=1
#SBATCH --output=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/32_div30_urd_lineage_tree_%j.log
#SBATCH --error=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/logs/32_div30_urd_lineage_tree_%j.log
#SBATCH --partition=standard
#SBATCH --account=parent0

set -euo pipefail
set -x

REPO_ROOT="/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline"
PROJECT_ROOT="/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder"
R_MODULE="${R_MODULE:-R/4.4.3}"
RUN_LABEL="${RUN_LABEL:-div30_first_urd_paper_radial_glia_smoke5k_knn100_v1}"
TREE_LABEL="${TREE_LABEL:-lineage_tree_radial_glia_tips_v1}"
PSEUDOTIME_NAME="${PSEUDOTIME_NAME:-paper_radial_glia_root}"
ANNOTATION_COL="${ANNOTATION_COL:-paper_cluster_annotation}"
ROOT_LABEL="${ROOT_LABEL:-Radial glia}"
TIP_LABELS="${TIP_LABELS:-SST+ cIN,PV neuron precursor,MGE subpallial neurons}"
TREE_SEED="${TREE_SEED:-7}"
TREE_N_PER_TIP="${TREE_N_PER_TIP:-5000}"
TREE_OPTIMAL_CELLS_FORWARD="${TREE_OPTIMAL_CELLS_FORWARD:-100}"
TREE_MAX_CELLS_BACK="${TREE_MAX_CELLS_BACK:-40}"
TREE_MINIMUM_VISITS="${TREE_MINIMUM_VISITS:-10}"
TREE_VISIT_THRESHOLD="${TREE_VISIT_THRESHOLD:-0.7}"
TREE_TOP_N_BRANCH_GENES="${TREE_TOP_N_BRANCH_GENES:-50}"

RUN_ROOT="${PROJECT_ROOT}/results/div30_first_urd/${RUN_LABEL}"
TREE_ROOT="${RUN_ROOT}/${TREE_LABEL}"
URD_RDS="${RUN_ROOT}/div30_first_urd_object.rds"
TREE_RDS="${TREE_ROOT}/div30_urd_lineage_tree_object.rds"
TIP_MAPPING="${TREE_ROOT}/tables/tree_tip_mapping.tsv"

mkdir -p "${PROJECT_ROOT}/logs" "${PROJECT_ROOT}/jobs" "${TREE_ROOT}"

echo "=== DIV30 URD lineage tree Slurm context ==="
date
hostname
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-}"
echo "PROJECT_ROOT=${PROJECT_ROOT}"
echo "REPO_ROOT=${REPO_ROOT}"
echo "RUN_LABEL=${RUN_LABEL}"
echo "TREE_LABEL=${TREE_LABEL}"
echo "URD_RDS=${URD_RDS}"
echo "TREE_N_PER_TIP=${TREE_N_PER_TIP}"

module load "${R_MODULE}"
module list 2>&1
Rscript --version
which Rscript

Rscript -e 'pkgs <- c("Matrix", "URD", "ggplot2"); status <- sapply(pkgs, requireNamespace, quietly=TRUE); print(data.frame(package=pkgs, installed=status), row.names=FALSE); quit(status=ifelse(all(status), 0, 1))'

Rscript "${REPO_ROOT}/scripts/16_div30_urd_build_lineage_tree.R" \
  --urd-rds "${URD_RDS}" \
  --outdir "${TREE_ROOT}" \
  --annotation-col "${ANNOTATION_COL}" \
  --pseudotime-name "${PSEUDOTIME_NAME}" \
  --root-label "${ROOT_LABEL}" \
  --tip-labels "${TIP_LABELS}" \
  --seed "${TREE_SEED}" \
  --optimal-cells-forward "${TREE_OPTIMAL_CELLS_FORWARD}" \
  --max-cells-back "${TREE_MAX_CELLS_BACK}" \
  --n-per-tip "${TREE_N_PER_TIP}" \
  --minimum-visits "${TREE_MINIMUM_VISITS}" \
  --visit-threshold "${TREE_VISIT_THRESHOLD}" \
  --top-n-branch-genes "${TREE_TOP_N_BRANCH_GENES}"

Rscript "${REPO_ROOT}/scripts/17_div30_urd_finalize_lineage_tree_report.R" \
  --tree-rds "${TREE_RDS}" \
  --outdir "${TREE_ROOT}" \
  --annotation-col "${ANNOTATION_COL}" \
  --pseudotime-name "${PSEUDOTIME_NAME}" \
  --tip-mapping "${TIP_MAPPING}" \
  --top-n-branch-genes "${TREE_TOP_N_BRANCH_GENES}"
