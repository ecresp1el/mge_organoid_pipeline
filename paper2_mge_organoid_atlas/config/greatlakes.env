# Paper 2 Great Lakes paths and default resources.
# This file contains configuration only; no source object is modified.

REPO_ROOT=/home/elcrespo/Desktop/githubprojects/mge_organoid_pipeline
MGE_PROJECT_ROOT=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder
PAPER2_ROOT=/nfs/turbo/umms-parent/mgeo_neuron_scrnaseq_projectfolder/paper2_mge_organoid_atlas
CONDA_ENV_BIN=/home/elcrespo/miniconda3/envs/mge-organoid-python/bin

ACCOUNT=parent0
PARTITION=standard
SEURAT5_MODULE=r-seurat/5.1.0-R-4.4.1-c3m7yfq

AUDIT_CPUS=4
AUDIT_MEMORY=128G
AUDIT_WALLTIME=12:00:00

CANONICAL_CPUS=4
CANONICAL_MEMORY=128G
CANONICAL_WALLTIME=24:00:00
CANONICAL_ARRAY_CONCURRENCY=4
CANONICAL_FINALIZE_CPUS=2
CANONICAL_FINALIZE_MEMORY=32G
CANONICAL_FINALIZE_WALLTIME=08:00:00

# PNG and PDF are always generated at 300 dpi. SVG is optional because its
# rasterized point layers can be large; when enabled, it is also fixed at 300.
MAKE_SVG=false
PNG_DPI=300
PDF_DPI=300
SVG_DPI=300
